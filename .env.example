# .env.example - ШАБЛОН (можно коммитить в Git)
# Скопируйте в .env и заполните реальными паролями!

# PostgreSQL
PG_HOST=
PG_PORT=5432
PG_DATABASE=churn_db
PG_USER=churn_user
PG_PASSWORD=CHANGE_ME_IN_PRODUCTION
# PostgreSQL (Timeweb Cloud) SSL
PG_SSL_MODE=require
# PG_SSL_ROOT_CERT= # при require не обязательно

# CDP Elasticsearch
ES_HOST=
ES_USERNAME=elastic
ES_PASSWORD=CHANGE_ME_IN_PRODUCTION
ES_INDEX_PATTERN=events-*
ES_VERIFY_CERTS=true

# Настройки обработки
BATCH_SIZE=1000
FETCH_HOURS=24
