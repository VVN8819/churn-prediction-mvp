*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.envenv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Логи (могут содержать секреты)
*.log
logs/

# Временные файлы
tmp/
temp/
*.tmp

